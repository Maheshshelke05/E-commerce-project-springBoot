pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                // फक्त repo checkout
                git branch: 'master2', url: 'https://github.com/RajAhire-1/E-commerce-project-springBoot.git'
            }
        }

        stage('List Files (Debug)') {
            steps {
                // फक्त एकदा पाहायला की pom.xml कुठे आहे
                sh 'pwd'
                sh 'ls'
            }
        }

        stage('Build with Maven') {
            steps {
                // इथे कुठेही cd नाही, directly root मधल्या pom.xml वर build
                sh 'mvn -f pom.xml clean package -DskipTests'
            }
        }

        stage('Upload JAR to EC2') {
            steps {
                // root/target मधला jar पाठव
                sh 'scp -o StrictHostKeyChecking=no target/*.jar ubuntu@3.111.144.92:/home/ubuntu/app.jar'
            }
        }

        stage('Deploy on EC2 & Restart Service') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@3.111.144.92 "
                  pkill -f app.jar || true
                  nohup java -jar /home/ubuntu/app.jar > app.log 2>&1 &
                "
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -f http://3.111.144.92:8080/actuator/health'
            }
        }
    }
}
