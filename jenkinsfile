pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master2', url: 'https://github.com/RajAhire-1/E-commerce-project-springBoot.git'
            }
        }

        stage('Build with Maven') {
            steps {
                dir('E-commerce-project-springBoot') {   // IMPORTANT ⬅ FIX
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Upload JAR to EC2') {
            steps {
                sh 'scp -o StrictHostKeyChecking=no E-commerce-project-springBoot/target/*.jar ubuntu@<EC2-PUBLIC-IP>:/home/ubuntu/app.jar'
            }
        }

        stage('Deploy on EC2 & Restart Service') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@<EC2-PUBLIC-IP> "
                pkill -f app.jar || true
                nohup java -jar /home/ubuntu/app.jar &
                "
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -f http://<EC2-PUBLIC-IP>:8080/actuator/health'
            }
        }
    }
}
