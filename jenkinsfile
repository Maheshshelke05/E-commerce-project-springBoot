pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master2', url: 'https://github.com/RajAhire-1/E-commerce-project-springBoot.git'
            }
        }

        stage('Build with Maven') {
            steps {
                dir('JtProject') {
                    sh './mvnw clean package -DskipTests || mvn clean package -DskipTests'
                }
            }
        }

        stage('Upload JAR to EC2') {
            steps {
                sh 'scp -o StrictHostKeyChecking=no JtProject/target/*.jar ubuntu@3.111.144.92:/home/ubuntu/app.jar'
            }
        }

        stage('Deploy on EC2 & Restart Service') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@3.111.144.92 "
                  pkill -f app.jar || true
                  nohup java -jar /home/ubuntu/app.jar > app.log 2>&1 &
                "
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -f http://3.111.144.92:8080/actuator/health'
            }
        }
    }
}
