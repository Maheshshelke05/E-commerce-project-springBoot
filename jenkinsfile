pipeline {
    agent any

    environment {
        APP_IP = "13.234.239.192"
        APP_USER = "ubuntu"
        APP_PATH = "/home/ubuntu/app.jar"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'master2', url: 'https://github.com/RajAhire-1/E-commerce-project-springBoot.git'
            }
        }

        stage('Build with Maven') {
            steps {
                dir('JtProject') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Upload & Deploy to EC2') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                    echo "=== Copying JAR to EC2 ==="
                    scp -o StrictHostKeyChecking=no \
                    JtProject/target/JtSpringProject-0.0.1-SNAPSHOT.jar \
                    ${APP_USER}@${APP_IP}:${APP_PATH}

                    echo "=== Restarting Spring Boot App ==="
                    ssh -o StrictHostKeyChecking=no ${APP_USER}@${APP_IP} << 'EOF'
                    echo "Stopping old app (if any)..."
                    pkill -f "java -jar /home/ubuntu/app.jar" || true

                    echo "Starting new app..."
                    nohup java -jar /home/ubuntu/app.jar > app.log 2>&1 &

                    echo "App deployed successfully!"
                    exit 0
EOF
                    '''
                }
            }
        }
    }
}
