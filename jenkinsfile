pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master2', url: 'https://github.com/RajAhire-1/E-commerce-project-springBoot.git'
            }
        }

        stage('Build with Maven') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Upload JAR to EC2') {
            steps {
                sh 'scp -o StrictHostKeyChecking=no target/*.jar ubuntu@<EC2-PUBLIC-IP>:/home/ubuntu/app.jar'
            }
        }

        stage('Deploy on EC2 & Restart Service') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@<EC2-PUBLIC-IP> "
                sudo systemctl stop myapp || true
                java -jar /home/ubuntu/app.jar &
                "
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -f http://<EC2-PUBLIC-IP>:8080/actuator/health'
            }
        }
    }
}
