pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                // repo checkout
                git branch: 'master2', url: 'https://github.com/RajAhire-1/E-commerce-project-springBoot.git'
            }
        }

        stage('List Files (Debug)') {
            steps {
                // workspace आणि project folder check
                sh '''
                  echo "== Workspace =="
                  pwd
                  ls
                  echo "== Inside E-commerce-project-springBoot =="
                  ls E-commerce-project-springBoot || echo "folder nahi distoy"
                '''
            }
        }

        stage('Build with Maven') {
            steps {
                // IMPORTANT: इथे project folder मध्ये जाऊन build करतो
                dir('E-commerce-project-springBoot') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Upload JAR to EC2') {
            steps {
                // jar हा E-commerce-project-springBoot/target मध्ये असेल
                sh 'scp -o StrictHostKeyChecking=no E-commerce-project-springBoot/target/*.jar ubuntu@3.111.144.92:/home/ubuntu/app.jar'
            }
        }

        stage('Deploy on EC2 & Restart Service') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@3.111.144.92 "
                  pkill -f app.jar || true
                  nohup java -jar /home/ubuntu/app.jar > app.log 2>&1 &
                "
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -f http://3.111.144.92:8080/actuator/health'
            }
        }
    }
}
